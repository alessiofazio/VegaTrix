# Copy to .env.production and replace every value.
# docker compose -f docker-compose.prod.yml --env-file .env.production up --build
#
# Production boot refuses: replace_me / empty / too-short secrets,
# FEATURE_CONNECTOR_MOCK=true, empty WEBHOOK_URL_ALLOWLIST, http:// public URLs, --seed.

APP_ENV=production
APP_NAME=OpenPay Protocol
SELF_HOSTED=true
EDITION=community

# Public URLs must be https://
APP_BASE_URL=https://pay.example.com
API_BASE_URL=https://api.example.com
DASHBOARD_BASE_URL=https://dash.example.com
WALLET_BASE_URL=https://wallet.example.com

POSTGRES_USER=openpay
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=openpay
DATABASE_URL=postgresql://openpay:change_this_postgres_password@postgres:5432/openpay
REDIS_URL=redis://redis:6379

# >= 32 chars, no "replace_me"
JWT_ACCESS_SECRET=generate_a_long_random_access_secret_here
JWT_REFRESH_SECRET=generate_a_different_refresh_secret_here
# 32 raw bytes or standard Base64 of 32 bytes
ENCRYPTION_MASTER_KEY=openpay-master-key-32-bytes!!ok
WEBHOOK_SIGNING_SECRET=generate_a_webhook_signing_secret
QR_SIGNING_SECRET=generate_a_qr_signing_secret

DEFAULT_CURRENCY=EUR
DEFAULT_TIMEZONE=Europe/Rome
LOG_LEVEL=info
METRICS_BIND_ADDR=0.0.0.0:9090
WORKER_BIND_ADDR=0.0.0.0:8081

FEATURE_CONNECTOR_MOCK=false
FEATURE_CONNECTOR_OPEN_BANKING=false
FEATURE_ADVANCED_ROUTING=false
FEATURE_ANALYTICS=false
FEATURE_SSO=false
TELEMETRY_OPT_IN=false

CORS_ALLOW_ORIGINS=https://dash.example.com,https://pay.example.com
# Hostnames only (merchant webhook hosts). Never list 169.254.169.254.
WEBHOOK_URL_ALLOWLIST=merchant.example.com
RATE_LIMIT_PER_MINUTE=120
QR_TTL_SECONDS=300
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TOLERANCE_SECS=300
