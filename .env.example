APP_ENV=development
APP_NAME=OpenPay Protocol
SELF_HOSTED=true
EDITION=community

APP_BASE_URL=http://localhost:3003
API_BASE_URL=http://localhost:8080
DASHBOARD_BASE_URL=http://localhost:3001

DATABASE_URL=postgresql://openpay:openpay@localhost:5432/openpay
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace_me_with_a_long_random_secret_32b
JWT_REFRESH_SECRET=replace_me_with_a_different_long_secret
ENCRYPTION_MASTER_KEY=replace_me_with_32_byte_base64_key!!
WEBHOOK_SIGNING_SECRET=replace_me_webhook_signing
QR_SIGNING_SECRET=replace_me_qr_signing_secret

DEFAULT_CURRENCY=EUR
DEFAULT_TIMEZONE=Europe/Rome
LOG_LEVEL=info
WALLET_BASE_URL=http://localhost:3003
METRICS_BIND_ADDR=0.0.0.0:9090
WORKER_BIND_ADDR=0.0.0.0:8081

FEATURE_CONNECTOR_MOCK=true
FEATURE_CONNECTOR_OPEN_BANKING=false
FEATURE_ADVANCED_ROUTING=false
FEATURE_ANALYTICS=false
FEATURE_SSO=false
TELEMETRY_OPT_IN=false

CORS_ALLOW_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
WEBHOOK_URL_ALLOWLIST=localhost,demo-merchant,127.0.0.1
RATE_LIMIT_PER_MINUTE=120
QR_TTL_SECONDS=300
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TOLERANCE_SECS=300
